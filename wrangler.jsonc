{
  // Worker 이름 (Cloudflare 대시보드에 표시되는 이름)
  "name": "looptop-discord-bot",

  // Worker 진입점
  "main": "src/index.ts",

  // Cloudflare Workers 호환성 날짜
  "compatibility_date": "2025-01-01",

  // D1 데이터베이스 바인딩 (Phase 3에서 database_id 채울 것)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "looptop-discord-bot",
      "database_id": "REPLACE_WITH_ACTUAL_D1_DATABASE_ID"
    }
  ],

  // Cron Triggers (UTC 기준)
  // KST 09:00 월요일 → UTC 00:00 월요일
  // KST 21:00 화~일  → UTC 12:00 화~일
  // KST 23:00 일요일 → UTC 14:00 일요일
  "triggers": {
    "crons": [
      "0 0 * * 1",
      "0 12 * * 2-7",
      "0 14 * * 0"
    ]
  },

  // 환경변수 (실제 값은 `wrangler secret put`으로 관리)
  // DISCORD_PUBLIC_KEY, DISCORD_APPLICATION_ID, DISCORD_BOT_TOKEN
  "vars": {}
}
